# Generated by `dagon gen`: the boot core of node {{node}}. dagon gen
# rewrites this file except `version` under [package], which is yours:
# raise it for each boot core you release (a node writes a boot core whose
# version differs from the one it runs). Change the rest through dagon.toml
# or the extension manifests.
# Build it here: `cargo build --release` (DAGON_PUBKEY as for every image).
[package]
name = "{{node}}-boot"
version = "0.1.0"
edition = "2021"
publish = false

# One crate per node's boot core: it builds for the boot core's target.
[workspace]

[[bin]]
name = "boot"
path = "boot.rs"
test = false

[features]
# Step blink codes and a panic blink (bring-up diagnostics).
diag = ["dagon-rp2040-bootcore/diag"]
# Test build that fails its own check, so its trial goes back to the confirmed core.
no-confirm = ["dagon-rp2040-bootcore/no-confirm"]
# Linked for boot core slot B (a release carries a core for each slot).
slot-b = ["dagon-rp2040-bootcore/slot-b"]

[dependencies]
{{dep:dagon-rp2040-bootcore}}
{{dep:dagon-events}}
{{boot_extensions}}

{{boot_metadata}}

[profile.release]
opt-level = "z"
lto = "fat"
codegen-units = 1
panic = "abort"
debug = true
