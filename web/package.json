{
  "name": "dagon-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "wasm": "wasm-pack build ../crates/dagon-wasm --release --target web --no-pack --out-dir ../../web/src/wasm/pkg",
    "predev": "npm run wasm",
    "dev": "vite",
    "prebuild": "npm run wasm",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "pretest": "npm run wasm",
    "test": "vitest run",
    "fonts": "node scripts/fonts.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
