# Generated by `dagon gen`: the boot core of node {{node}}. Do not edit:
# dagon gen rewrites it; change dagon.toml or the extension manifests.
# Build it here: `cargo build --release` (DAGON_PUBKEY as for every image).
[package]
name = "{{node}}-boot"
version = "0.1.0"
edition = "2021"
publish = false

# One crate per node's boot core: it builds for the boot core's target.
[workspace]

[[bin]]
name = "boot"
path = "boot.rs"
test = false

[features]
# Linked for boot core slot B (a release carries a core for each slot).
slot-b = ["dagon-stm32f401re-bootcore/slot-b"]

[dependencies]
{{dep:dagon-stm32f401re-bootcore}}
{{dep:dagon-events}}
{{boot_extensions}}

{{boot_metadata}}

[profile.release]
opt-level = "z"
lto = "fat"
codegen-units = 1
panic = "abort"
debug = true
